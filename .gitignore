# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
coverage

# Download cache della pipeline dati: file grezzi, non vanno committati.
scripts/pipeline/.cache

# Output dei test end-to-end Playwright (§9 SPEC F7): rigenerati a ogni esecuzione.
/test-results/
/playwright-report/
/playwright/.cache/

# Chiavi, token e dati personali: non devono mai finire nel repo.
# La chiave API Anthropic e il token del Gist vivono solo in IndexedDB nel browser.
# Pattern volutamente specifici: wildcard generiche come *token*/*secret* catturano
# anche codice legittimo (es. "tokenize.ts").
.env
.env.*
*.pem
secrets.*
*.secrets
credentials.*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
